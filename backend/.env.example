PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/telemedicine
JWT_SECRET=your-very-long-and-secure-random-secret-key
CLIENT_URL=http://localhost:5173,https://your-app-domain.com

# ML Service URLs (HuggingFace)
HF_API_URL=https://your-hf-space-api.hf.space

# Local ML Fallback (Optional)
# On Linux (Render/Heroku/Vercel): Use 'python3'
# On Windows: Use 'python' or path to python.exe
PYTHON_CMD=python3

# Metered.ca TURN Settings (Video Calls)
VITE_METERED_API_KEY=your-api-key
VITE_METERED_APP_NAME=your-app-name
