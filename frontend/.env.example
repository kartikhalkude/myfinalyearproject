# Frontend Environment Variables - Example
# Copy this file to .env and update the values as needed

# API Server URL (must end with /api)
# Local: http://localhost:5000/api
# Production: https://your-backend-url.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Environment
VITE_ENV=production

# ─── METERED.CA TURN CONFIG (Required for Video Calls) ───────────────────────
VITE_METERED_API_KEY=your-api-key
VITE_METERED_APP_NAME=your-app-name

# ─── FALLBACK STATIC TURN CONFIG (Optional) ──────────────────────────────────
VITE_TURN_SERVER_URL=turn:global.metered.ca:443
VITE_TURN_SERVER_USERNAME=your-username
VITE_TURN_SERVER_PASSWORD=your-password
